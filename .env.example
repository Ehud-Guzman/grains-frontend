# ── Vittorios frontend — environment variables ────────────────────────────────
# Only VITE_* variables are read by the client, and every VITE_* value is
# embedded in the shipped JS bundle — treat all of them as public. Never put a
# secret here (API secrets, Daraja consumer keys, SMTP passwords, etc. belong in
# the BACKEND's .env, which is never shipped to a browser).
#
# Local copies:            copy this file to .env
# Production values:       set them in Netlify → Site settings → Environment
#                          variables. .env.production is gitignored, so a value
#                          set there only affects local `npm run build` runs.

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of the Express API, including the /api suffix.
# dev:        http://localhost:5000/api
# production: https://grains-backend-b3n0.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Canonical public origin of THIS site — no trailing slash.
# Used by:
#   • src/utils/site.js  — canonical link + og:* tags emitted by <Seo>
#   • index.html         — og:image / og:url / Twitter card / JSON-LD
#                          (Vite substitutes %VITE_SITE_URL% at build time)
#   • vite.config.js     — generates dist/robots.txt and dist/sitemap.xml
# Change this one value when the site moves to a custom domain; nothing else
# needs editing.
VITE_SITE_URL=https://grains-fronten.netlify.app

# ── Optional integrations — leave blank to disable ────────────────────────────

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Blank = analytics disabled.
# Only takes effect in a production build — see src/utils/analytics.js.
# Enabling this requires adding googletagmanager.com to script-src and
# connect-src in public/_headers' CSP, plus a workbox cacheName bump in
# vite.config.js so installed service workers pick up the new policy.
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for frontend error tracking. Blank = error reporting disabled.
# Only takes effect in a production build — see src/utils/sentry.js.
# Enabling this requires adding the Sentry ingest host to connect-src in
# public/_headers' CSP, plus a workbox cacheName bump in vite.config.js.
VITE_SENTRY_DSN=
